<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C111C"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="FIXMASTER"
            android:textColor="#8FA8FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="NUEVA SOLICITUD"
            android:textColor="#AAB4C8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/service_request_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:maxLines="3"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#F7F8FA"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/service_request_expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#B7C0D2"
            android:textSize="15sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <Button
            android:id="@+id/service_request_view"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#5B7FFF"
            android:minHeight="48dp"
            android:text="Ver solicitud"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/service_request_close"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="36dp"
            android:backgroundTint="#202A3B"
            android:minHeight="48dp"
            android:text="Cerrar"
            android:textAllCaps="false"
            android:textColor="#E7EAF0"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>