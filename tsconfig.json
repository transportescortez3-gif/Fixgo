{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/*"]
    }
  },
  "include": [
    "client/**/*",
    "server/**/*",
    "lib/db/src/**/*",
    "scripts/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "build.mjs"
  ]
}
