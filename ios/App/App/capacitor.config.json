{
  "appId": "com.fixxer.app",
  "appName": "Fixgo",
  "webDir": "dist/public",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0F172A",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
