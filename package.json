{
  "name": "fixgo",
  "version": "1.3.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:home-alerts": "tsx client/lib/home-alerts.test.ts",
    "test:service-alert-state": "tsx client/lib/service-alert-state.test.ts",
    "test:client-service-selection": "tsx client/lib/service-selection.test.ts",
    "test:category-browser-navigation": "tsx client/lib/category-browser-navigation.test.ts",
    "test:service-alerts": "tsx server/lib/alert-recipient-selection.test.ts && tsx artifacts/api-server/src/lib/service-alert-policy.test.ts && tsx client/lib/service-alert-state.test.ts",
    "test:service-alerts-e2e": "tsx scripts/test-service-alerts-e2e.ts",
    "test:account-suspension": "tsx server/lib/account-suspension-regression.test.ts && tsx client/lib/account-suspension.test.ts",
    "test:chat-attachments": "tsx server/lib/chat-attachments-regression.test.ts",
    "test:e2e-key-backup": "tsx client/lib/e2e-key-backup-regression.test.ts",
    "build": "vite build && node build.mjs",
    "start": "NODE_ENV=production node --enable-source-maps dist/server/index.mjs",
    "db:migrate": "tsx server/lib/migrate.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "postinstall": "node scripts/apply-android-patches.mjs",
    "mobile:prepare": "npm run build && node scripts/apply-android-patches.mjs && node scripts/mobile-prepare.mjs",
    "mobile:check": "node scripts/mobile-check.mjs",
    "mobile:build": "npm run mobile:prepare",
    "mobile:android": "npm run mobile:prepare && node scripts/mobile-check.mjs android && cd android && ./gradlew assembleDebug",
    "mobile:android:release": "npm run mobile:prepare && node scripts/mobile-check.mjs android --release && cd android && ./gradlew bundleRelease && cd .. && node scripts/package-android-release.mjs",
    "mobile:ios": "npm run mobile:prepare && node scripts/mobile-check.mjs ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "mobile:sync": "npm run mobile:prepare"
  },
  "dependencies": {
